# ── Checkpoints and model weights ─────────────────────────────────────────
checkpoints/*
!checkpoints/.gitkeep
# Alternate/experiment checkpoint dirs (e.g. train_cfg.checkpoint_dir set to
# something other than "checkpoints/" — experiments.py does this per-run,
# and so does ad-hoc local testing) — same rationale as checkpoints/ above,
# just not sharing its literal name.
checkpoints_*/
*.pt
*.pth
*.bin
*.safetensors

# ── Dataset cache (large, re-downloadable) ────────────────────────────────
data_cache/
data_processed/
__pycache__/
*.pyc
*.pyo

# ── Results (generated at runtime) ────────────────────────────────────────
# The directory is tracked via .gitkeep so `mkdir` isn't needed after clone.
# Once you have a real run, add results explicitly:
#   git add -f results/eval_results.json results/training_history.json
results/*
!results/.gitkeep

# ── Python environment ────────────────────────────────────────────────────
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── OS noise ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
